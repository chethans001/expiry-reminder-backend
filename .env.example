# =====================================================================
# Expiry Reminder - Backend Environment Configuration (Render / Server)
# =====================================================================
# Add these variables in Render Dashboard -> Web Service -> Environment

# 1. Server Port (Render sets PORT automatically, defaults to 5000 locally)
PORT=5000
NODE_ENV=production

# 2. Database Connection String (MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslaccept=strict
# Compatible with TiDB Cloud, Aiven MySQL, PlanetScale, Clever Cloud, or Render external MySQL
DATABASE_URL=mysql://user:password@host:3306/expiry_reminder

# 3. Application JWT Secret
# Generate a strong random 64-character secret
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# 4. Frontend Client URL (For CORS whitelist)
# Format: https://your-expiry-reminder.vercel.app
CLIENT_URL=https://your-app.vercel.app

# 5. Supabase Server-Side Verification
# Used by the backend to securely verify incoming Supabase access tokens via supabase.auth.getUser(token)
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# Use your Supabase "service_role" secret key (recommended for server) OR the "anon" key:
# Found in: Supabase Dashboard -> Project Settings -> API -> "service_role" "secret"
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
# SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 6. Email Alerts (Optional - for Nodemailer reminders and password resets)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM="Expiry Reminder <no-reply@expiryreminder.app>"
